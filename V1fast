"""Greedy draft-model speculative decoding with a CUDA-graph draft. Pretrained weights only."""
import argparse
import time
from collections import defaultdict
from pathlib import Path

import torch
from transformers import AutoModelForCausalLM, AutoTokenizer, DynamicCache, StaticCache

MODELS_DIR = Path(__file__).resolve().parents[2] / "models"

PROMPTS = [
    "Write a Python function that checks whether a string is a palindrome.",
    "Explain how binary search works and give a Python implementation.",
    "Write a Python class implementing a stack with push, pop and peek.",
    "Explain the difference between a process and a thread.",
    "Write a SQL query to find the second highest salary in an Employee table.",
]


def model_path(name):
    p = Path(name)
    if not p.is_dir():
        p = MODELS_DIR / name
    if not p.is_dir():
        found = sorted(x.name for x in MODELS_DIR.iterdir()) if MODELS_DIR.is_dir() else []
        raise FileNotFoundError(f"{p} not found. Contents of {MODELS_DIR}: {found}")
    return str(p)


def trim(tokens, max_new, eos):
    tokens = tokens[:, :max_new]
    hit = (tokens[0] == eos).nonzero()
    return tokens[:, : hit[0].item() + 1] if len(hit) else tokens


class Timer:
    """Splits a round into phases. Only active when profiling (adds GPU syncs)."""

    def __init__(self, on=False):
        self.on, self.t, self.acc = on, 0.0, defaultdict(float)

    def mark(self, key=None):
        if not self.on:
            return
        torch.cuda.synchronize()
        now = time.perf_counter()
        if key:
            self.acc[key] += now - self.t
        self.t = now


class Drafter:
    """Draft model on a static KV cache. Rolling back is just moving `pos` back:
    stale entries past `pos` are masked by the causal mask and later overwritten."""

    def __init__(self, model, max_len, use_graph):
        self.model, self.pos = model, 0
        self.cache = make_static_cache(model, max_len)
        self.cp = torch.zeros(1, dtype=torch.long, device=model.device)
        self.step = (torch.compile(self._step, mode="reduce-overhead", fullgraph=True)
                     if use_graph else self._step)

    def _step(self, tok, cp):
        out = self.model(tok, past_key_values=self.cache, cache_position=cp, use_cache=True)
        return out.logits[:, -1].argmax(-1, keepdim=True)

    def prefill(self, ids):
        n = ids.shape[1]
        cp = torch.arange(n, device=ids.device)
        self.model(ids, past_key_values=self.cache, cache_position=cp, use_cache=True)
        self.pos = n

    def feed(self, tok, p):
        self.cp.fill_(p)
        torch.compiler.cudagraph_mark_step_begin()
        return self.step(tok, self.cp).clone()

    def propose(self, seq, k):
        n = seq.shape[1]
        for p in range(self.pos, n):
            nxt = self.feed(seq[:, p:p + 1].clone(), p)
        drafts = [nxt]
        for i in range(k - 1):
            nxt = self.feed(nxt, n + i)
            drafts.append(nxt)
        self.pos = n + k - 1
        return torch.cat(drafts, 1)


def make_static_cache(model, max_len):
    try:
        return StaticCache(config=model.config, max_batch_size=1, max_cache_len=max_len,
                           device=model.device, dtype=model.dtype)
    except TypeError:
        return StaticCache(config=model.config, max_cache_len=max_len)


def baseline(target, ids, max_new, eos):
    cache = DynamicCache()
    nxt = target(ids, past_key_values=cache, use_cache=True).logits[:, -1].argmax(-1, keepdim=True)
    out = [nxt]
    for i in range(1, max_new):
        if i % 16 == 0 and (torch.cat(out, 1) == eos).any():
            break
        nxt = target(nxt, past_key_values=cache, use_cache=True).logits[:, -1].argmax(-1, keepdim=True)
        out.append(nxt)
    return trim(torch.cat(out, 1), max_new, eos), {}


def speculative(target, drafter, ids, max_new, eos, k, timer=None):
    timer = timer or Timer()
    tc = DynamicCache()
    logits = target(ids, past_key_values=tc, use_cache=True).logits[:, -1]
    drafter.prefill(ids)
    first = logits.argmax(-1, keepdim=True)
    seq = torch.cat([ids, first], 1)
    plen = ids.shape[1]
    done = first.item() == eos
    rounds = accepted = 0

    # Invariant: both caches hold seq[:-1]
    while seq.shape[1] - plen < max_new and not done:
        timer.mark()
        n_tok = seq.shape[1]
        d = drafter.propose(seq, k)
        timer.mark("draft")

        v = torch.cat([seq[:, -1:], d], 1)
        t = target(v, past_key_values=tc, use_cache=True).logits.argmax(-1)
        timer.mark("verify")

        vals = torch.cat([t, d], 1)[0].tolist()
        tl, dl = vals[:k + 1], vals[k + 1:]
        n = 0
        while n < k and tl[n] == dl[n]:
            n += 1
        seq = torch.cat([seq, t[:, :n + 1]], 1)
        tc.crop(n_tok + n)
        drafter.pos = min(drafter.pos, seq.shape[1] - 1)
        done = eos in tl[:n + 1]
        rounds += 1
        accepted += n
        timer.mark("other")

    stats = {"rounds": rounds, "accepted": accepted, "drafted": rounds * k}
    return trim(seq[:, plen:], max_new, eos), stats


def first_diff(a, b):
    n = min(a.shape[1], b.shape[1])
    diff = (a[0, :n] != b[0, :n]).nonzero()
    if len(diff):
        return diff[0].item()
    return None if a.shape[1] == b.shape[1] else n


def top2_gap(target, ids, ref, i):
    x = torch.cat([ids, ref[:, :i]], 1)
    top = target(x).logits[0, -1].float().topk(2).values
    return (top[0] - top[1]).item()


def timed(fn, *args):
    torch.cuda.synchronize()
    t0 = time.perf_counter()
    out, stats = fn(*args)
    torch.cuda.synchronize()
    return out, stats, time.perf_counter() - t0


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--target", default="Qwen3-32B")
    ap.add_argument("--draft", default="Qwen3-0.6B")
    ap.add_argument("--k", type=int, nargs="+", default=[2, 3, 4])
    ap.add_argument("--max-new", type=int, default=256)
    ap.add_argument("--warmup", type=int, default=3)
    ap.add_argument("--no-compile", action="store_true", help="static cache without CUDA graphs")
    ap.add_argument("--profile", action="store_true", help="print draft/verify/other ms per round")
    a = ap.parse_args()
    torch.set_grad_enabled(False)

    target_path, draft_path = model_path(a.target), model_path(a.draft)
    tok = AutoTokenizer.from_pretrained(target_path, local_files_only=True)
    kw = dict(torch_dtype=torch.bfloat16, attn_implementation="sdpa",
              device_map="cuda", local_files_only=True)
    target = AutoModelForCausalLM.from_pretrained(target_path, **kw).eval()
    draft = AutoModelForCausalLM.from_pretrained(draft_path, **kw).eval()
    eos = tok.eos_token_id

    def encode(p):
        text = tok.apply_chat_template(
            [{"role": "user", "content": p}], tokenize=False,
            add_generation_prompt=True, enable_thinking=False)
        return tok(text, return_tensors="pt").input_ids.cuda()

    batch = [encode(p) for p in PROMPTS]
    max_len = max(b.shape[1] for b in batch) + a.max_new + max(a.k) + 8
    drafter = Drafter(draft, max_len, use_graph=not a.no_compile)

    print("warming up (first run compiles, this can take a minute)...")
    for _ in range(a.warmup):
        baseline(target, batch[0], 32, eos)
        for k in a.k:
            speculative(target, drafter, batch[0], 32, eos, k)

    base_tok = base_time = 0
    base_out = []
    for ids in batch:
        out, _, dt = timed(baseline, target, ids, a.max_new, eos)
        base_out.append(out)
        base_tok += out.shape[1]
        base_time += dt
    base_tps = base_tok / base_time
    print(f"baseline: {base_tps:.1f} tok/s")

    print(f"{'k':>3} {'tok/s':>8} {'speedup':>8} {'accept':>8} {'tok/round':>10} {'match':>6}")
    diffs = []
    for k in a.k:
        n_tok = t_sum = rounds = acc = drafted = match = 0
        for j, (ids, ref) in enumerate(zip(batch, base_out)):
            out, s, dt = timed(speculative, target, drafter, ids, a.max_new, eos, k)
            n_tok += out.shape[1]
            t_sum += dt
            rounds += s["rounds"]
            acc += s["accepted"]
            drafted += s["drafted"]
            i = first_diff(out, ref)
            if i is None:
                match += 1
            else:
                diffs.append(f"k={k} prompt {j}: first diff at token {i}, "
                             f"top-2 logit gap {top2_gap(target, ids, ref, i):.3f}")
        tps = n_tok / t_sum
        print(f"{k:>3} {tps:>8.1f} {tps / base_tps:>7.2f}x {acc / drafted:>8.2%} "
              f"{(acc + rounds) / rounds:>10.2f} {match:>3}/{len(batch)}")

    if diffs:
        print("\nmismatches (a gap near 0, about 0.125 or less, means a bf16 near-tie):")
        print("\n".join(diffs))

    if a.profile:
        print("\nprofile, ms per round:")
        for k in a.k:
            timer = Timer(on=True)
            _, s, _ = timed(speculative, target, drafter, batch[0], a.max_new, eos, k, timer)
            parts = " ".join(f"{key} {timer.acc[key] * 1000 / s['rounds']:.1f}"
                             for key in ("draft", "verify", "other"))
            print(f"k={k}: {parts}")

    print(f"\npeak GPU memory: {torch.cuda.max_memory_allocated() / 2**30:.1f} GiB")


if __name__ == "__main__":
    main()
